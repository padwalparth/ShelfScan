 * BatchScan AI · Advanced OCR & Packaging Intelligence
 * Frontend Application Controller with Supabase Cloud Database Integration
 */

// Application State
const state = {
  selectedFile: null,
  selectedSample: null,
  imageBase64: null,
  sourceName: 'upload.jpg',
  rotateDeg: 0,
  isEnhanced: false,
  stream: null,
  apiKey: localStorage.getItem('batchscan_api_key') || '',
  model: (() => {
    const cached = localStorage.getItem('batchscan_model') || '';
    const validModels = [
      'gemini-3.5-flash-lite',
      'gemini-flash-lite-latest',
      'gemini-3.5-flash',
      'gemini-3.7-flash',
      'meta/llama-3.2-11b-vision-instruct'
    ];
    if (!cached || !validModels.includes(cached)) {
      localStorage.setItem('batchscan_model', 'gemini-3.5-flash-lite');
      return 'gemini-3.5-flash-lite';
    }
    return cached;
  })(),
  samples: [],
  history: JSON.parse(localStorage.getItem('batchscan_history') || '[]'),
  currentResult: null,

  // Supabase State
  supabaseConnected: false,
  supabaseProject: '',
  supabaseScans: [],
  supabaseInventory: [],
  supabaseSearch: '',
  supabaseStatusFilter: 'ALL',
  activeDbTab: 'cloud',
  intelligenceData: null
};

