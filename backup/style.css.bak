/* ==========================================================================
   Design System & Theme Tokens
   ========================================================================== */
:root {
  --bg-primary: #070a12;
  --bg-secondary: #0d121f;
  --bg-card: rgba(17, 24, 39, 0.72);
  --bg-card-hover: rgba(31, 41, 55, 0.85);
  --bg-card-active: rgba(30, 41, 59, 0.95);
  --bg-glass: rgba(15, 23, 42, 0.65);
  
  --border-subtle: rgba(255, 255, 255, 0.08);
  --border-focus: rgba(16, 185, 129, 0.5);
  --border-glow: rgba(56, 189, 248, 0.35);

  --text-primary: #f8fafc;
  --text-secondary: #94a3b8;
  --text-muted: #64748b;
  --text-accent: #38bdf8;

  --accent-emerald: #10b981;
  --accent-emerald-glow: rgba(16, 185, 129, 0.25);
  --accent-cyan: #06b6d4;
  --accent-blue: #3b82f6;
  --accent-purple: #8b5cf6;
  --accent-amber: #f59e0b;
  --accent-rose: #f43f5e;

  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-xl: 20px;
  --radius-full: 9999px;

  --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.3);
  --shadow-md: 0 8px 24px rgba(0, 0, 0, 0.45);
  --shadow-lg: 0 16px 40px rgba(0, 0, 0, 0.6);
  --shadow-glow: 0 0 30px rgba(16, 185, 129, 0.15);

  --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --font-display: 'Outfit', var(--font-sans);
  --font-mono: 'JetBrains Mono', 'Fira Code', monospace;

  --transition-fast: 150ms cubic-bezier(0.4, 0, 0.2, 1);
  --transition-normal: 250ms cubic-bezier(0.4, 0, 0.2, 1);
}

/* Base & Reset */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: var(--font-sans);
  background-color: var(--bg-primary);
  color: var(--text-primary);
  min-height: 100vh;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  position: relative;
  overflow-x: hidden;
}

/* Background Atmospheric Elements */
.app-background {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: -1;
  overflow: hidden;
  pointer-events: none;
}

.glow-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(120px);
  opacity: 0.25;
}

.glow-1 {
  width: 600px;
  height: 600px;
  background: radial-gradient(circle, #10b981 0%, rgba(6, 182, 212, 0.4) 100%);
  top: -150px;
  left: 10%;
}

.glow-2 {
  width: 700px;
  height: 700px;
  background: radial-gradient(circle, #6366f1 0%, rgba(139, 92, 246, 0.3) 100%);
  bottom: -200px;
  right: 5%;
}

.grid-overlay {
  position: absolute;
  inset: 0;
  background-image: 
    linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
  background-size: 40px 40px;
  mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);
}

/* Container */
.app-container {
  max-width: 1440px;
  margin: 0 auto;
  padding: 24px 28px 60px;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

/* Header */
.app-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
  padding: 16px 24px;
  background: var(--bg-glass);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-md);
}

.header-brand {
  display: flex;
  align-items: center;
  gap: 16px;
}

.brand-logo {
  width: 48px;
  height: 48px;
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, #10b981, #06b6d4);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  box-shadow: 0 4px 16px rgba(16, 185, 129, 0.35);
}

.brand-title {
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  display: flex;
  align-items: center;
  gap: 10px;
}

.gradient-text {
  background: linear-gradient(135deg, #ffffff 30%, #a7f3d0 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.badge-ai {
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: 3px 8px;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.2), rgba(6, 182, 212, 0.2));
  color: #34d399;
  border: 1px solid rgba(52, 211, 153, 0.3);
}

.brand-subtitle {
  font-size: 0.82rem;
  color: var(--text-secondary);
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.status-indicator-pill {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 14px;
  border-radius: var(--radius-full);
  background: rgba(16, 185, 129, 0.1);
  border: 1px solid rgba(16, 185, 129, 0.25);
  font-size: 0.8rem;
  font-weight: 500;
  color: #34d399;
}

.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: #10b981;
}

.status-dot.pulsing {
  box-shadow: 0 0 0 rgba(16, 185, 129, 0.4);
  animation: pulse-dot 2s infinite;
}

@keyframes pulse-dot {
  0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
  70% { box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
  100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
}

/* Layout Grid */
.main-layout {
  display: grid;
  grid-template-columns: 1fr 1.15fr;
  gap: 24px;
}

@media (max-width: 1080px) {
  .main-layout {
    grid-template-columns: 1fr;
  }
}

/* Glass Panels */
.panel {
  background: var(--bg-card);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-xl);
  padding: 24px;
  box-shadow: var(--shadow-md);
  display: flex;
  flex-direction: column;
  gap: 20px;
  position: relative;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--border-subtle);
  padding-bottom: 16px;
}

.panel-title {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--text-primary);
}

.panel-title h2 {
  font-family: var(--font-display);
  font-size: 1.15rem;
  font-weight: 600;
}

/* Tabs */
.mode-tabs {
  display: flex;
  background: rgba(0, 0, 0, 0.4);
  padding: 4px;
  border-radius: var(--radius-lg);
  border: 1px solid var(--border-subtle);
  gap: 4px;
}

.tab-btn {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 7px 14px;
  border-radius: var(--radius-md);
  border: none;
  background: transparent;
  color: var(--text-secondary);
  font-size: 0.84rem;
  font-weight: 500;
  cursor: pointer;
  transition: var(--transition-fast);
}

.tab-btn:hover {
  color: var(--text-primary);
  background: rgba(255, 255, 255, 0.05);
}

.tab-btn.active {
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.25), rgba(6, 182, 212, 0.25));
  color: #ffffff;
  border: 1px solid rgba(16, 185, 129, 0.4);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
}

.tab-pane {
  display: none;
}

.tab-pane.active {
  display: block;
}

/* Upload Dropzone */
.drop-zone {
  border: 2px dashed rgba(255, 255, 255, 0.14);
  border-radius: var(--radius-lg);
  padding: 36px 20px;
  text-align: center;
  cursor: pointer;
  transition: var(--transition-normal);
  background: rgba(0, 0, 0, 0.25);
}

.drop-zone:hover, .drop-zone.dragover {
  border-color: #10b981;
  background: rgba(16, 185, 129, 0.05);
  box-shadow: 0 0 20px rgba(16, 185, 129, 0.15);
}

.file-input-hidden {
  display: none;
}

.upload-icon-circle {
  width: 60px;
  height: 60px;
  margin: 0 auto 16px;
  border-radius: 50%;
  background: rgba(16, 185, 129, 0.1);
  color: #34d399;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(16, 185, 129, 0.2);
}

.drop-primary {
  font-size: 1rem;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4px;
}

.drop-secondary {
  font-size: 0.85rem;
  color: var(--text-secondary);
  margin-bottom: 12px;
}

.browse-link {
  color: #38bdf8;
  text-decoration: underline;
}

.drop-hints {
  display: inline-flex;
  gap: 8px;
  font-size: 0.75rem;
  color: var(--text-muted);
  background: rgba(255, 255, 255, 0.03);
  padding: 4px 12px;
  border-radius: var(--radius-full);
}

/* Camera Live View */
.camera-container {
  position: relative;
  width: 100%;
  height: 270px;
  background: #000;
  border-radius: var(--radius-lg);
  overflow: hidden;
  border: 1px solid var(--border-subtle);
}

#cameraStream {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.viewfinder-overlay {
  position: absolute;
  inset: 0;
  pointer-events: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.corner-bracket {
  position: absolute;
  width: 24px;
  height: 24px;
  border-color: #10b981;
  border-style: solid;
}

.corner-bracket.top-left { top: 20px; left: 20px; border-width: 3px 0 0 3px; border-top-left-radius: 6px; }
.corner-bracket.top-right { top: 20px; right: 20px; border-width: 3px 3px 0 0; border-top-right-radius: 6px; }
.corner-bracket.bottom-left { bottom: 20px; left: 20px; border-width: 0 0 3px 3px; border-bottom-left-radius: 6px; }
.corner-bracket.bottom-right { bottom: 20px; right: 20px; border-width: 0 3px 3px 0; border-bottom-right-radius: 6px; }

.center-crosshair {
  width: 40px;
  height: 40px;
  border: 1px dashed rgba(16, 185, 129, 0.5);
  border-radius: 4px;
}

.viewfinder-hint {
  position: absolute;
  bottom: 12px;
  background: rgba(0, 0, 0, 0.7);
  padding: 4px 12px;
  border-radius: var(--radius-full);
  font-size: 0.74rem;
  color: #e2e8f0;
  backdrop-filter: blur(4px);
}

.camera-controls {
  display: flex;
  gap: 10px;
  margin-top: 12px;
}

.btn-capture {
  flex: 1;
}

/* Sample Gallery */
.samples-header {
  font-size: 0.84rem;
  color: var(--text-secondary);
  margin-bottom: 12px;
}

.samples-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
  gap: 12px;
}

.sample-card {
  background: rgba(0, 0, 0, 0.35);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 8px;
  cursor: pointer;
  transition: var(--transition-fast);
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.sample-card:hover {
  border-color: #10b981;
  background: rgba(16, 185, 129, 0.08);
  transform: translateY(-2px);
}

.sample-card.active {
  border-color: #10b981;
  box-shadow: 0 0 12px rgba(16, 185, 129, 0.3);
  background: rgba(16, 185, 129, 0.12);
}

.sample-thumb-wrap {
  width: 100%;
  height: 90px;
  border-radius: 6px;
  overflow: hidden;
  background: #000;
}

.sample-thumb-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.sample-name {
  font-size: 0.76rem;
  font-weight: 600;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sample-gt-pill {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  color: #34d399;
  background: rgba(16, 185, 129, 0.15);
  padding: 2px 6px;
  border-radius: 4px;
}

/* Selected Image Preview & Controls */
.preview-card {
  background: rgba(0, 0, 0, 0.4);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg);
  padding: 14px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.preview-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.preview-title {
  font-size: 0.84rem;
  font-family: var(--font-mono);
  color: #38bdf8;
  max-width: 180px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.preview-tools {
  display: flex;
  gap: 6px;
}

.tool-btn {
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 5px 10px;
  border-radius: var(--radius-md);
  border: 1px solid var(--border-subtle);
  background: rgba(255, 255, 255, 0.05);
  color: var(--text-secondary);
  font-size: 0.78rem;
  cursor: pointer;
  transition: var(--transition-fast);
}

.tool-btn:hover {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.2);
}

.tool-btn.active {
  background: rgba(16, 185, 129, 0.2);
  border-color: #10b981;
  color: #34d399;
}

.tool-btn-danger:hover {
  background: rgba(244, 63, 94, 0.2);
  border-color: #f43f5e;
  color: #f43f5e;
}

.preview-viewport {
  position: relative;
  width: 100%;
  max-height: 280px;
  min-height: 180px;
  background: #020617;
  border-radius: var(--radius-md);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

#imagePreview {
  max-width: 100%;
  max-height: 280px;
  object-fit: contain;
  transition: filter 200ms ease, transform 200ms ease;
}

#imagePreview.enhanced {
  filter: contrast(140%) brightness(105%) saturate(110%);
}

/* Animated Laser Scanner */
.laser-scanner {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: linear-gradient(90deg, transparent, #10b981, #06b6d4, #10b981, transparent);
  box-shadow: 0 0 15px #10b981, 0 0 30px #06b6d4;
  animation: laser-sweep 1.8s ease-in-out infinite alternate;
  z-index: 10;
}

@keyframes laser-sweep {
  0% { top: 5%; opacity: 0.8; }
  100% { top: 95%; opacity: 1; }
}

/* Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 18px;
  border-radius: var(--radius-md);
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
  transition: var(--transition-normal);
  border: none;
  outline: none;
}

.btn-lg {
  padding: 14px 24px;
  font-size: 1rem;
  border-radius: var(--radius-lg);
}

.btn-sm {
  padding: 6px 12px;
  font-size: 0.8rem;
}

.btn-xs {
  padding: 4px 8px;
  font-size: 0.74rem;
}

.w-full {
  width: 100%;
}

.btn-primary {
  background: #10b981;
  color: #042f20;
}

.btn-primary:hover {
  background: #34d399;
  box-shadow: 0 4px 16px rgba(16, 185, 129, 0.4);
}

.btn-gradient {
  background: linear-gradient(135deg, #10b981 0%, #06b6d4 100%);
  color: #04241e;
  box-shadow: 0 4px 20px rgba(16, 185, 129, 0.35);
}

.btn-gradient:hover:not(:disabled) {
  background: linear-gradient(135deg, #34d399 0%, #22d3ee 100%);
  box-shadow: 0 6px 28px rgba(16, 185, 129, 0.55);
  transform: translateY(-1px);
}

.btn-gradient:disabled {
  opacity: 0.4;
  cursor: not-allowed;
  box-shadow: none;
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.07);
  color: var(--text-primary);
  border: 1px solid var(--border-subtle);
}

.btn-secondary:hover {
  background: rgba(255, 255, 255, 0.12);
  border-color: rgba(255, 255, 255, 0.2);
}

.btn-barcode {
  background: linear-gradient(135deg, rgba(14, 165, 233, 0.14) 0%, rgba(99, 102, 241, 0.14) 100%);
  color: #38bdf8;
  border: 1px solid rgba(56, 189, 248, 0.45);
  box-shadow: 0 4px 18px rgba(14, 165, 233, 0.15);
  font-weight: 600;
  transition: all var(--transition-normal);
}

.btn-barcode:hover:not(:disabled) {
  background: linear-gradient(135deg, rgba(14, 165, 233, 0.25) 0%, rgba(99, 102, 241, 0.25) 100%);
  border-color: rgba(56, 189, 248, 0.85);
  color: #ffffff;
  box-shadow: 0 6px 24px rgba(14, 165, 233, 0.35);
  transform: translateY(-1px);
}

.btn-barcode:disabled {
  opacity: 0.4;
  cursor: not-allowed;
  box-shadow: none;
  border-color: var(--border-subtle);
  color: var(--text-muted);
}

.btn-danger {
  background: rgba(244, 63, 94, 0.15);
  color: #f43f5e;
  border: 1px solid rgba(244, 63, 94, 0.3);
}

.btn-danger:hover {
  background: rgba(244, 63, 94, 0.25);
}

.btn-spinner {
  width: 18px;
  height: 18px;
  border: 2px solid rgba(0, 0, 0, 0.2);
  border-top-color: currentColor;
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* Results & Intelligence Panel */
.results-panel {
  min-height: 520px;
}

.results-meta {
  display: flex;
  align-items: center;
  gap: 8px;
}

.meta-item {
  font-size: 0.78rem;
  color: var(--text-secondary);
}

.badge-pill-subtle {
  background: rgba(255, 255, 255, 0.06);
  padding: 3px 8px;
  border-radius: var(--radius-full);
  font-family: var(--font-mono);
  font-size: 0.72rem;
}

/* Empty State */
.empty-state, .loading-state {
  margin: auto;
  text-align: center;
  padding: 48px 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}

.empty-icon {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.03);
  border: 1px dashed var(--border-subtle);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
}

.empty-state h3, .loading-state h3 {
  font-family: var(--font-display);
  font-size: 1.2rem;
  font-weight: 600;
  color: var(--text-primary);
}

.empty-state p, .loading-state p {
  font-size: 0.88rem;
  color: var(--text-secondary);
  max-width: 360px;
}

/* Loading Radar */
.pulsing-scan-indicator {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  border: 2px solid rgba(16, 185, 129, 0.3);
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 24px rgba(16, 185, 129, 0.2);
}

.radar-sweep {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: conic-gradient(from 0deg, transparent 60%, rgba(16, 185, 129, 0.6) 100%);
  animation: radar-rotate 1.2s linear infinite;
}

@keyframes radar-rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* Results Content */
.results-container {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

/* Ground Truth Verification Banner */
.gt-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 16px;
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.15), rgba(6, 182, 212, 0.15));
  border: 1px solid rgba(16, 185, 129, 0.35);
  border-radius: var(--radius-md);
  font-size: 0.82rem;
}

.gt-badge {
  display: flex;
  align-items: center;
  gap: 6px;
  font-weight: 700;
  color: #34d399;
}

.gt-details {
  color: #a7f3d0;
  font-size: 0.78rem;
}

/* Batch Field Grid */
.batch-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}

@media (max-width: 640px) {
  .batch-grid {
    grid-template-columns: 1fr;
  }
}

.batch-card {
  background: rgba(0, 0, 0, 0.35);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 14px 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  transition: var(--transition-fast);
}

.batch-card:hover {
  border-color: rgba(255, 255, 255, 0.18);
  background: rgba(255, 255, 255, 0.03);
}

.card-hero {
  grid-column: 1 / -1;
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.12), rgba(6, 182, 212, 0.08));
  border: 1px solid rgba(16, 185, 129, 0.3);
  box-shadow: 0 4px 18px rgba(16, 185, 129, 0.1);
}

.card-expiry {
  background: rgba(0, 0, 0, 0.4);
}

.card-label {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--text-muted);
}

.batch-value-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.batch-value-lg {
  font-family: var(--font-mono);
  font-size: 1.65rem;
  font-weight: 700;
  color: #34d399;
  letter-spacing: 0.03em;
}

.batch-value-med {
  font-family: var(--font-mono);
  font-size: 1.15rem;
  font-weight: 600;
  color: #ffffff;
}

.batch-value-sm {
  font-size: 0.88rem;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.4;
}

.btn-copy-chip {
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-sm);
  color: var(--text-secondary);
  padding: 6px 8px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: var(--transition-fast);
}

.btn-copy-chip:hover {
  background: #10b981;
  color: #042f20;
  border-color: #10b981;
}

/* Status Badges */
.status-pill {
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  padding: 3px 10px;
  border-radius: var(--radius-full);
}

.badge-success {
  background: rgba(16, 185, 129, 0.2);
  color: #34d399;
  border: 1px solid rgba(16, 185, 129, 0.4);
}

.badge-warning {
  background: rgba(245, 158, 11, 0.2);
  color: #fbbf24;
  border: 1px solid rgba(245, 158, 11, 0.4);
}

.badge-danger {
  background: rgba(244, 63, 94, 0.2);
  color: #fb7185;
  border: 1px solid rgba(244, 63, 94, 0.4);
}

.badge-info {
  background: rgba(56, 189, 248, 0.2);
  color: #38bdf8;
  border: 1px solid rgba(56, 189, 248, 0.4);
}

.badge-neutral {
  background: rgba(255, 255, 255, 0.1);
  color: var(--text-muted);
}

.expiry-subtext {
  font-size: 0.74rem;
  color: var(--text-secondary);
}

/* Notes Bar */
.notes-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(0, 0, 0, 0.25);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 10px 14px;
  font-size: 0.8rem;
  color: var(--text-secondary);
}

/* Detail Section Tabs */
.detail-tabs-section {
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  background: rgba(0, 0, 0, 0.35);
  overflow: hidden;
}

.detail-tabs-nav {
  display: flex;
  background: rgba(0, 0, 0, 0.4);
  border-bottom: 1px solid var(--border-subtle);
}

.detail-tab-btn {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 10px 16px;
  border: none;
  background: transparent;
  color: var(--text-secondary);
  font-size: 0.82rem;
  font-weight: 500;
  cursor: pointer;
  transition: var(--transition-fast);
}

.detail-tab-btn:hover {
  color: var(--text-primary);
}

.detail-tab-btn.active {
  color: #38bdf8;
  border-bottom: 2px solid #38bdf8;
  background: rgba(56, 189, 248, 0.05);
}

.detail-pane {
  display: none;
  padding: 14px;
}

.detail-pane.active {
  display: block;
}

.code-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
  font-size: 0.76rem;
  color: var(--text-muted);
}

.code-actions {
  display: flex;
  gap: 6px;
}

.ocr-text-box, .json-box {
  font-family: var(--font-mono);
  font-size: 0.82rem;
  line-height: 1.6;
  background: #020617;
  padding: 12px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border-subtle);
  color: #e2e8f0;
  max-height: 160px;
  overflow-y: auto;
  white-space: pre-wrap;
  word-break: break-word;
}

.json-box {
  color: #a7f3d0;
}

/* Export Actions */
.export-actions {
  display: flex;
  gap: 10px;
  margin-top: 4px;
}

/* History Section */
.history-panel {
  margin-top: 8px;
}

.counter-badge {
  background: rgba(16, 185, 129, 0.2);
  color: #34d399;
  font-size: 0.74rem;
  font-weight: 700;
  padding: 2px 8px;
  border-radius: var(--radius-full);
  margin-left: 6px;
}

.history-actions {
  display: flex;
  gap: 8px;
}

.table-responsive {
  width: 100%;
  overflow-x: auto;
}

.history-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
  font-size: 0.84rem;
}

.history-table th {
  padding: 12px 14px;
  font-weight: 600;
  color: var(--text-muted);
  border-bottom: 1px solid var(--border-subtle);
  background: rgba(0, 0, 0, 0.25);
  font-size: 0.74rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.history-table td {
  padding: 12px 14px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  color: var(--text-primary);
}

.history-table tr:hover td {
  background: rgba(255, 255, 255, 0.02);
}

.history-batch-code {
  font-family: var(--font-mono);
  font-weight: 700;
  color: #34d399;
}

.empty-row td {
  text-align: center;
  color: var(--text-muted);
  padding: 32px 14px;
}

/* Forms & Modals */
.form-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 16px;
}

.form-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--text-primary);
}

.label-badge {
  font-size: 0.7rem;
  padding: 2px 6px;
  background: rgba(16, 185, 129, 0.2);
  color: #34d399;
  border-radius: 4px;
}

.form-input, .form-select {
  width: 100%;
  padding: 10px 14px;
  border-radius: var(--radius-md);
  border: 1px solid var(--border-subtle);
  background: rgba(0, 0, 0, 0.4);
  color: var(--text-primary);
  font-size: 0.88rem;
  outline: none;
  transition: var(--transition-fast);
}

.form-input:focus, .form-select:focus {
  border-color: #10b981;
  box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
}

.input-with-action {
  display: flex;
  gap: 8px;
}

.form-hint {
  font-size: 0.76rem;
  color: var(--text-muted);
}

.form-hint code {
  background: rgba(255, 255, 255, 0.08);
  padding: 2px 4px;
  border-radius: 4px;
  color: #38bdf8;
}

.checkbox-label {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.85rem;
  color: var(--text-secondary);
  cursor: pointer;
}

/* Modal */
.modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.75);
  backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  opacity: 0;
  pointer-events: none;
  transition: var(--transition-normal);
}

.modal-backdrop.open {
  opacity: 1;
  pointer-events: auto;
}

.modal-card {
  background: var(--bg-secondary);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-xl);
  width: 100%;
  max-width: 520px;
  padding: 24px;
  box-shadow: var(--shadow-lg);
  transform: scale(0.95);
  transition: var(--transition-normal);
}

.modal-backdrop.open .modal-card {
  transform: scale(1);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
}

.modal-title {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--text-primary);
}

.modal-title h3 {
  font-family: var(--font-display);
  font-size: 1.15rem;
  font-weight: 600;
}

.modal-close {
  background: transparent;
  border: none;
  color: var(--text-muted);
  font-size: 1.5rem;
  cursor: pointer;
  padding: 4px 8px;
  border-radius: var(--radius-sm);
  transition: var(--transition-fast);
}

.modal-close:hover {
  color: var(--text-primary);
}

.modal-footer {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 24px;
  border-top: 1px solid var(--border-subtle);
  padding-top: 16px;
}

/* Toast Notifications */
.toast-container {
  position: fixed;
  bottom: 24px;
  right: 24px;
  z-index: 2000;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.toast {
  background: var(--bg-card-active);
  border: 1px solid var(--border-subtle);
  border-left: 4px solid #10b981;
  color: #ffffff;
  padding: 12px 18px;
  border-radius: var(--radius-md);
  font-size: 0.85rem;
  box-shadow: var(--shadow-lg);
  display: flex;
  align-items: center;
  gap: 10px;
  animation: toast-in 0.25s ease-out;
}

.toast.toast-error {
  border-left-color: #f43f5e;
}

@keyframes toast-in {
  from { transform: translateX(100%); opacity: 0; }
  to { transform: translateX(0); opacity: 1; }
}

/* Custom Scrollbar */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
::-webkit-scrollbar-track {
  background: rgba(0, 0, 0, 0.2);
}
::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.15);
  border-radius: var(--radius-full);
}
::-webkit-scrollbar-thumb:hover {
  background: rgba(255, 255, 255, 0.25);
}

/* ==========================================================================
   Supabase Cloud PostgreSQL Theme Styles
   ========================================================================== */
.status-indicator-pill.status-supabase {
  background: rgba(56, 189, 248, 0.1);
  border-color: rgba(56, 189, 248, 0.3);
  color: #38bdf8;
  display: flex;
  align-items: center;
  gap: 7px;
}

.status-indicator-pill.status-supabase.connected {
  background: rgba(16, 185, 129, 0.12);
  border-color: rgba(16, 185, 129, 0.35);
  color: #34d399;
}

.status-indicator-pill.status-supabase.error {
  background: rgba(244, 63, 94, 0.12);
  border-color: rgba(244, 63, 94, 0.35);
  color: #fb7185;
}

.badge-pill-cloud {
  background: rgba(56, 189, 248, 0.15);
  color: #38bdf8;
  border: 1px solid rgba(56, 189, 248, 0.3);
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 4px 10px;
  border-radius: var(--radius-full);
  font-size: 0.76rem;
  font-weight: 500;
}

/* Cloud Stats Cards */
.cloud-stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 14px;
  margin-bottom: 20px;
}

.stat-card {
  background: rgba(17, 24, 39, 0.6);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 14px 16px;
  display: flex;
  align-items: center;
  gap: 14px;
  transition: var(--transition-normal);
  backdrop-filter: blur(8px);
}

.stat-card:hover {
  border-color: rgba(255, 255, 255, 0.15);
  transform: translateY(-2px);
  background: rgba(30, 41, 59, 0.7);
}

.stat-icon-wrap {
  width: 42px;
  height: 42px;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon-blue {
  background: rgba(56, 189, 248, 0.15);
  color: #38bdf8;
}

.icon-purple {
  background: rgba(139, 92, 246, 0.15);
  color: #a78bfa;
}

.icon-green {
  background: rgba(16, 185, 129, 0.15);
  color: #34d399;
}

.icon-amber {
  background: rgba(245, 158, 11, 0.15);
  color: #fbbf24;
}

.icon-emerald {
  background: rgba(6, 182, 212, 0.15);
  color: #22d3ee;
}

.stat-info {
  display: flex;
  flex-direction: column;
}

.stat-label {
  font-size: 0.74rem;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.04em;
  font-weight: 500;
}

.stat-value {
  font-family: var(--font-display);
  font-size: 1.35rem;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.2;
}

/* DB Navigation Tabs */
.db-panel-header {
  flex-wrap: wrap;
  gap: 12px;
  padding-bottom: 14px;
  border-bottom: 1px solid var(--border-subtle);
  margin-bottom: 16px;
}

.db-tabs {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.db-tab-btn {
  background: transparent;
  border: 1px solid transparent;
  color: var(--text-secondary);
  padding: 8px 14px;
  border-radius: var(--radius-md);
  font-size: 0.85rem;
  font-weight: 500;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 8px;
  transition: var(--transition-fast);
}

.db-tab-btn:hover {
  color: var(--text-primary);
  background: rgba(255, 255, 255, 0.05);
}

.db-tab-btn.active {
  background: rgba(56, 189, 248, 0.12);
  color: #38bdf8;
  border-color: rgba(56, 189, 248, 0.35);
}

.counter-badge {
  background: rgba(255, 255, 255, 0.1);
  color: var(--text-primary);
  font-size: 0.72rem;
  font-weight: 600;
  padding: 2px 7px;
  border-radius: var(--radius-full);
}

.db-tab-btn.active .counter-badge {
  background: rgba(56, 189, 248, 0.25);
  color: #e0f2fe;
}

/* DB Filter & Search controls */
.db-filter-group {
  display: flex;
  align-items: center;
  gap: 8px;
}

.db-search-input {
  background: rgba(15, 23, 42, 0.8);
  border: 1px solid var(--border-subtle);
  color: var(--text-primary);
  padding: 6px 12px;
  border-radius: var(--radius-sm);
  font-size: 0.8rem;
  width: 170px;
  outline: none;
  transition: var(--transition-fast);
}

.db-search-input:focus {
  border-color: #38bdf8;
  box-shadow: 0 0 0 2px rgba(56, 189, 248, 0.2);
}

.db-status-select {
  background: rgba(15, 23, 42, 0.8);
  border: 1px solid var(--border-subtle);
  color: var(--text-secondary);
  padding: 6px 10px;
  border-radius: var(--radius-sm);
  font-size: 0.8rem;
  outline: none;
  cursor: pointer;
}

.db-status-select:focus {
  border-color: #38bdf8;
}

/* DB Panes */
.db-pane {
  display: none;
}

.db-pane.active {
  display: block;
}

/* Supabase Cloud Card in Settings */
.cloud-settings-card {
  background: rgba(15, 23, 42, 0.85);
  border: 1px solid rgba(56, 189, 248, 0.25);
  border-radius: var(--radius-md);
  padding: 14px 16px;
  margin-bottom: 20px;
}

.cloud-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
}

.cloud-card-title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 600;
  color: var(--text-primary);
  font-size: 0.92rem;
}

.cloud-card-details {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.detail-row {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.8rem;
}

.detail-label {
  color: var(--text-muted);
  width: 90px;
}

.detail-val {
  color: var(--text-secondary);
}

.detail-val.font-mono {
  font-family: var(--font-mono);
  color: #38bdf8;
  font-size: 0.78rem;
}

.table-actions-cell {
  display: flex;
  align-items: center;
  gap: 6px;
}

.btn-icon-danger {
  color: #f43f5e;
  border-color: rgba(244, 63, 94, 0.2);
}

.btn-icon-danger:hover {
  background: rgba(244, 63, 94, 0.15);
}

/* ==========================================================================
   AI Intelligence & Expiry Analytics Dashboard
   ========================================================================== */
.tab-intelligence-btn {
  background: linear-gradient(135deg, rgba(239, 68, 68, 0.12), rgba(139, 92, 246, 0.15)) !important;
  border-color: rgba(239, 68, 68, 0.3) !important;
  color: #fca5a5 !important;
}

.tab-intelligence-btn.active {
  background: linear-gradient(135deg, rgba(239, 68, 68, 0.25), rgba(139, 92, 246, 0.3)) !important;
  border-color: #f87171 !important;
  color: #ffffff !important;
  box-shadow: 0 0 16px rgba(239, 68, 68, 0.25);
}

.badge-pulse-alert {
  background: #dc2626 !important;
  color: #ffffff !important;
  font-weight: 700;
  animation: pulseBadge 1.8s infinite;
}

@keyframes pulseBadge {
  0%, 100% {
    transform: scale(1);
    box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.7);
  }
  50% {
    transform: scale(1.08);
    box-shadow: 0 0 0 6px rgba(220, 38, 38, 0);
  }
}

.intel-dashboard-container {
  display: flex;
  flex-direction: column;
  gap: 20px;
  padding: 10px 0;
}

/* Key Metrics Strip */
.intel-metrics-strip {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 16px;
}

.intel-metric-card {
  display: flex;
  align-items: center;
  gap: 16px;
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg);
  padding: 18px 20px;
  backdrop-filter: blur(12px);
  transition: all var(--transition-normal);
}

.intel-metric-card:hover {
  transform: translateY(-2px);
  border-color: var(--border-glow);
  box-shadow: var(--shadow-md);
}

.metric-health {
  border-left: 4px solid #10b981;
}

.metric-risk {
  border-left: 4px solid #f43f5e;
}

.metric-bestseller {
  border-left: 4px solid #f59e0b;
}

.metric-icon-circle {
  width: 48px;
  height: 48px;
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5rem;
  flex-shrink: 0;
}

.metric-text-group {
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}

.metric-label {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--text-muted);
  font-weight: 600;
}

.metric-val-row {
  display: flex;
  align-items: baseline;
  gap: 10px;
  flex-wrap: wrap;
}

.metric-val {
  font-size: 1.45rem;
  font-weight: 700;
  font-family: var(--font-display);
  color: var(--text-primary);
}

.metric-val-truncate {
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 170px;
}

.metric-sub {
  font-size: 0.8rem;
  color: var(--text-secondary);
}

.metric-badge-danger {
  background: rgba(244, 63, 94, 0.15);
  color: #fb7185;
  border: 1px solid rgba(244, 63, 94, 0.3);
  padding: 2px 8px;
  border-radius: var(--radius-full);
  font-size: 0.75rem;
  font-weight: 600;
}

.metric-badge-success {
  background: rgba(16, 185, 129, 0.15);
  color: #34d399;
  border: 1px solid rgba(16, 185, 129, 0.3);
  padding: 2px 8px;
  border-radius: var(--radius-full);
  font-size: 0.75rem;
  font-weight: 600;
}

/* Section Boxes */
.intel-section-box {
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg);
  padding: 22px;
  backdrop-filter: blur(12px);
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.section-critical-alerts {
  border: 1px solid rgba(244, 63, 94, 0.35);
  background: linear-gradient(180deg, rgba(244, 63, 94, 0.06) 0%, rgba(17, 24, 39, 0.75) 100%);
}

.section-box-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--border-subtle);
  padding-bottom: 14px;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 12px;
}

.section-icon {
  font-size: 1.4rem;
}

.section-title h3 {
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 2px;
}

.section-title p {
  font-size: 0.8rem;
  color: var(--text-muted);
}

.section-badge-counter {
  background: rgba(244, 63, 94, 0.2);
  border: 1px solid rgba(244, 63, 94, 0.4);
  color: #fca5a5;
  font-size: 0.78rem;
  font-weight: 700;
  padding: 4px 12px;
  border-radius: var(--radius-full);
}

/* 5-Day Critical Expiry Cards Grid */
.alerts-cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 14px;
}

.alert-empty-card {
  grid-column: 1 / -1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 24px;
  background: rgba(16, 185, 129, 0.05);
  border: 1px dashed rgba(16, 185, 129, 0.25);
  border-radius: var(--radius-md);
  color: #34d399;
  font-size: 0.9rem;
}

.alert-item-card {
  background: rgba(15, 23, 42, 0.85);
  border: 1px solid rgba(244, 63, 94, 0.35);
  border-radius: var(--radius-md);
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  position: relative;
  overflow: hidden;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
  transition: all var(--transition-normal);
}

.alert-item-card:hover {
  transform: translateY(-2px);
  border-color: #f43f5e;
  box-shadow: 0 8px 24px rgba(244, 63, 94, 0.2);
}

.alert-item-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 4px;
  height: 100%;
  background: #f43f5e;
}

.alert-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10px;
}

.alert-product-name {
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--text-primary);
}

.alert-batch-chip {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: #38bdf8;
  background: rgba(56, 189, 248, 0.1);
  padding: 2px 6px;
  border-radius: var(--radius-sm);
  display: inline-block;
  margin-top: 2px;
}

.alert-countdown-pill {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  background: #e11d48;
  color: #ffffff;
  font-size: 0.75rem;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: var(--radius-full);
  white-space: nowrap;
}

.alert-card-meta {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
  font-size: 0.8rem;
  color: var(--text-secondary);
  background: rgba(0, 0, 0, 0.2);
  padding: 8px 10px;
  border-radius: var(--radius-sm);
}

.alert-directive-box {
  background: rgba(244, 63, 94, 0.1);
  border: 1px dashed rgba(244, 63, 94, 0.3);
  padding: 10px;
  border-radius: var(--radius-sm);
  font-size: 0.82rem;
  color: #fecdd3;
  line-height: 1.4;
}

.alert-action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-top: 2px;
}

.btn-clearance {
  background: linear-gradient(135deg, #e11d48, #be123c);
  color: #ffffff;
  border: none;
  border-radius: var(--radius-sm);
  padding: 6px 12px;
  font-size: 0.78rem;
  font-weight: 600;
  cursor: pointer;
  transition: all var(--transition-fast);
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.btn-clearance:hover {
  background: linear-gradient(135deg, #f43f5e, #e11d48);
  box-shadow: 0 0 12px rgba(244, 63, 94, 0.4);
}

/* Split Grid Layout */
.intel-split-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

@media (max-width: 900px) {
  .intel-split-grid {
    grid-template-columns: 1fr;
  }
}

/* Product Sales Velocity Table */
.velocity-table-wrap {
  overflow-x: auto;
}

.velocity-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.86rem;
}

.velocity-table th {
  text-align: left;
  padding: 10px 12px;
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--text-muted);
  border-bottom: 1px solid var(--border-subtle);
}

.velocity-table td {
  padding: 12px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  vertical-align: middle;
}

.velocity-rank {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.08);
  font-size: 0.75rem;
  font-weight: 700;
  margin-right: 8px;
}

.velocity-rank-1 {
  background: #f59e0b;
  color: #000000;
}

.velocity-rank-2 {
  background: #94a3b8;
  color: #000000;
}

.velocity-rank-3 {
  background: #b45309;
  color: #ffffff;
}

.velocity-badge-pill {
  display: inline-block;
  padding: 3px 8px;
  border-radius: var(--radius-full);
  font-size: 0.75rem;
  font-weight: 600;
}

.vel-HIGH {
  background: rgba(245, 158, 11, 0.15);
  color: #fbbf24;
  border: 1px solid rgba(245, 158, 11, 0.3);
}

.vel-MODERATE {
  background: rgba(56, 189, 248, 0.15);
  color: #38bdf8;
  border: 1px solid rgba(56, 189, 248, 0.3);
}

.vel-SLOW {
  background: rgba(148, 163, 184, 0.12);
  color: #94a3b8;
  border: 1px solid rgba(148, 163, 184, 0.25);
}

.share-bar-container {
  display: flex;
  align-items: center;
  gap: 8px;
}

.share-bar-bg {
  flex: 1;
  height: 6px;
  background: rgba(255, 255, 255, 0.08);
  border-radius: var(--radius-full);
  overflow: hidden;
}

.share-bar-fill {
  height: 100%;
  border-radius: var(--radius-full);
  background: linear-gradient(90deg, #38bdf8, #10b981);
}

/* Smart Suggestions List */
.suggestions-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.suggestion-card {
  background: rgba(15, 23, 42, 0.7);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  transition: all var(--transition-normal);
}

.suggestion-card:hover {
  border-color: var(--border-glow);
  transform: translateX(3px);
}

.suggestion-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.suggestion-title-group {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 700;
  font-size: 0.9rem;
  color: var(--text-primary);
}

.suggestion-badge {
  font-size: 0.72rem;
  font-weight: 600;
  padding: 2px 8px;
  border-radius: var(--radius-full);
}

.badge-danger {
  background: rgba(244, 63, 94, 0.2);
  color: #fb7185;
}

.badge-success {
  background: rgba(16, 185, 129, 0.2);
  color: #34d399;
}

.badge-warning {
  background: rgba(245, 158, 11, 0.2);
  color: #fbbf24;
}

.badge-info {
  background: rgba(56, 189, 248, 0.2);
  color: #38bdf8;
}

.suggestion-body {
  font-size: 0.82rem;
  color: var(--text-secondary);
  line-height: 1.45;
}

.suggestion-action-btn {
  align-self: flex-start;
  margin-top: 4px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid var(--border-subtle);
  color: var(--text-primary);
  font-size: 0.75rem;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.suggestion-action-btn:hover {
  background: rgba(255, 255, 255, 0.12);
  border-color: var(--border-focus);
}

/* AI Executive Briefing Box */
.section-ai-briefing {
  border: 1px solid rgba(139, 92, 246, 0.3);
  background: linear-gradient(180deg, rgba(139, 92, 246, 0.05) 0%, rgba(17, 24, 39, 0.8) 100%);
}

.briefing-time-tag {
  font-size: 0.75rem;
  color: var(--text-muted);
  font-family: var(--font-mono);
  margin-right: 8px;
}

.ai-briefing-content {
  background: rgba(11, 15, 25, 0.75);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 20px;
  font-size: 0.88rem;
  line-height: 1.65;
  color: var(--text-primary);
  max-height: 480px;
  overflow-y: auto;
}

.ai-briefing-content h1, 
.ai-briefing-content h2, 
.ai-briefing-content h3 {
  color: #38bdf8;
  margin: 14px 0 8px 0;
  font-family: var(--font-display);
}

.ai-briefing-content h1:first-child,
.ai-briefing-content h2:first-child,
.ai-briefing-content h3:first-child {
  margin-top: 0;
}

.ai-briefing-content p {
  margin-bottom: 10px;
  color: var(--text-secondary);
}

.ai-briefing-content ul {
  padding-left: 20px;
  margin-bottom: 12px;
}

.ai-briefing-content li {
  margin-bottom: 6px;
  color: var(--text-secondary);
}

.ai-briefing-content strong {
  color: #f8fafc;
}

.ai-briefing-content code {
  background: rgba(255, 255, 255, 0.08);
  padding: 2px 6px;
  border-radius: var(--radius-sm);
  font-family: var(--font-mono);
  color: #a78bfa;
}

.ai-briefing-placeholder {
  text-align: center;
  padding: 30px;
  color: var(--text-muted);
}

/* ==========================================================================
   Barcode & 2D Matrix Intelligence Styles
   ========================================================================== */
.action-btn-group {
  display: flex;
  gap: 12px;
  width: 100%;
}

.banners-strip {
  display: flex;
  flex-direction: column;
  gap: 10px;
  width: 100%;
}

.barcode-banner {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 16px;
  border-radius: var(--radius-md);
  background: rgba(14, 165, 233, 0.08);
  border: 1px solid rgba(56, 189, 248, 0.25);
  box-shadow: 0 4px 16px rgba(14, 165, 233, 0.1);
  animation: fadeIn 0.3s ease;
}

.barcode-banner.banner-verified {
  background: rgba(16, 185, 129, 0.08);
  border-color: rgba(16, 185, 129, 0.3);
}

.barcode-banner.banner-warning {
  background: rgba(245, 158, 11, 0.08);
  border-color: rgba(245, 158, 11, 0.3);
}

.barcode-badge-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  border-radius: var(--radius-full);
  font-size: 0.78rem;
  font-weight: 600;
  background: rgba(56, 189, 248, 0.15);
  color: #38bdf8;
  border: 1px solid rgba(56, 189, 248, 0.3);
  white-space: nowrap;
}

.barcode-banner.banner-verified .barcode-badge-chip {
  background: rgba(16, 185, 129, 0.15);
  color: #10b981;
  border-color: rgba(16, 185, 129, 0.3);
}

.barcode-banner.banner-warning .barcode-badge-chip {
  background: rgba(245, 158, 11, 0.15);
  color: #f59e0b;
  border-color: rgba(245, 158, 11, 0.3);
}

.barcode-banner-details {
  font-size: 0.85rem;
  color: var(--text-secondary);
  line-height: 1.4;
}

.card-barcode {
  border-color: rgba(56, 189, 248, 0.25);
  background: linear-gradient(135deg, rgba(14, 165, 233, 0.04) 0%, rgba(17, 24, 39, 0.72) 100%);
}

.barcode-sub-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  margin-top: 8px;
}

.barcode-origin-badge {
  font-size: 0.72rem;
  font-weight: 600;
  padding: 3px 8px;
  border-radius: var(--radius-sm);
  background: rgba(255, 255, 255, 0.06);
  color: #cbd5e1;
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.barcode-checksum-pill {
  font-size: 0.72rem;
  font-weight: 500;
  padding: 3px 8px;
  border-radius: var(--radius-sm);
  background: rgba(16, 185, 129, 0.1);
  color: #10b981;
  border: 1px solid rgba(16, 185, 129, 0.2);
}

.barcode-checksum-pill.checksum-invalid {
  background: rgba(244, 63, 94, 0.1);
  color: #f43f5e;
  border-color: rgba(244, 63, 94, 0.2);
}

.barcode-details-box {
  padding: 16px;
  background: rgba(10, 15, 29, 0.85);
  border-radius: var(--radius-md);
  border: 1px solid var(--border-subtle);
}

.barcode-kv-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 12px;
  margin-bottom: 16px;
}

.barcode-kv-item {
  background: rgba(255, 255, 255, 0.03);
  padding: 10px 14px;
  border-radius: var(--radius-sm);
  border: 1px solid rgba(255, 255, 255, 0.05);
}

.barcode-kv-label {
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--text-muted);
  margin-bottom: 4px;
}

.barcode-kv-val {
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--text-primary);
}

.barcode-gs1-section {
  margin-top: 14px;
  padding-top: 12px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.barcode-gs1-title {
  font-size: 0.78rem;
  font-weight: 700;
  color: #38bdf8;
  margin-bottom: 8px;
  display: flex;
  align-items: center;
  gap: 6px;
}

.barcode-table-badge {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: 0.76rem;
  padding: 2px 7px;
  border-radius: 4px;
  background: rgba(56, 189, 248, 0.12);
  color: #38bdf8;
  border: 1px solid rgba(56, 189, 248, 0.25);
}

.barcode-empty-hint {
  text-align: center;
  padding: 24px;
  color: var(--text-muted);
  font-size: 0.88rem;
}



